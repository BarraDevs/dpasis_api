generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(uuid())
  email              String  @unique
  password           String  @db.Text
  passwordResetToken String? @db.VarChar(64)
  status             String
  roles              Role[]
}

model Role {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      String

  admin Admin?

  @@unique([accountId, role])
}

model Admin {
  accountId String   @unique
  name      String   @db.VarChar(256)
  document  String   @unique @db.VarChar(256)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId    String   @unique

  @@id([accountId])
}

model Client {
  id              String   @unique @default(uuid())
  kind            String   @db.VarChar(256)
  cnpj            String   @unique @db.VarChar(256)
  ie              String   @unique @db.VarChar(256)
  group           String   @db.VarChar(256)
  type            String   @db.VarChar(256)
  companyName     String   @db.VarChar(256)
  fantasyName     String   @db.VarChar(256)
  owner           String   @db.VarChar(256)
  headquarters    String   @db.VarChar(256)
  generateInvoice Boolean
  active          Boolean
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Address {
  id           String   @id @default(uuid())
  isMain       Boolean
  nickname     String?  @db.VarChar(256)
  zipCode      String   @db.VarChar(256)
  street       String   @db.VarChar(512)
  number       String   @db.VarChar(256)
  complement   String?  @db.VarChar(256)
  reference    String?  @db.VarChar(256)
  neighborhood String   @db.VarChar(256)
  city         String   @db.VarChar(256)
  state        String   @db.VarChar(256)
  ownerId      String   @db.VarChar(256)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Contact {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(256)
  department String   @db.VarChar(256)
  email      String   @db.VarChar(256)
  phone      String   @db.VarChar(256)
  whatsapp   String   @db.VarChar(256)
  info       String?  @db.Text
  ownerId    String   @db.VarChar(256)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Faq {
  id        String   @id @default(uuid())
  question  String   @db.Text
  answer    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Text {
  id        String   @id @default(uuid())
  type      String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
