generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 Int     @id @default(autoincrement())
  role               String
  name               String
  email              String  @unique
  password           String  @db.Text
  passwordResetToken String? @db.VarChar(64)
  status             String

  admin Admin?

  @@unique([id, role])
  @@map("accounts")
}

model Admin {
  accountId Int      @unique
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  document  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([accountId])
  @@map("admins")
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String   @db.Text
  answer    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model Text {
  id        Int      @id @default(autoincrement())
  type      String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("texts")
}


model ClientGroup {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Client Client[]
  @@map("client_groups")
}

model ClientOwner {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Client Client[]
  @@map("client_owners")
}

model Client {
  id        Int      @id @default(autoincrement())
  type      String
  document  String @unique
  ie        String?
  groupId   Int
  ownerId   Int
  companyName String
  fantasyName String?
  headquarters String
  invoiceType String
  generateInvoice Boolean
  active        Boolean
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  group ClientGroup @relation(fields: [groupId], references: [id])
  owner ClientOwner @relation(fields: [ownerId], references: [id])

  @@map("clients")
}