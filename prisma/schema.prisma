generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(uuid())
  email              String  @unique
  password           String  @db.Text
  passwordResetToken String? @db.VarChar(64)
  status             String
  roles              Role[]

  @@map("accounts")
}

model Role {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      String

  admin  Admin?
  seller Seller?

  @@unique([accountId, role])
  @@map("roles")
}

model Admin {
  accountId String   @unique
  name      String   @db.VarChar(256)
  document  String   @unique @db.VarChar(256)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId    String   @unique

  @@id([accountId])
  @@map("admins")
}

model Company {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(256)
  fantasyName String  @db.VarChar(256)
  document    String  @unique @db.VarChar(256)
  ie          String  @db.VarChar(256)
  active      Boolean

  zipCode      String  @db.VarChar(256)
  street       String  @db.VarChar(512)
  number       String  @db.VarChar(256)
  complement   String? @db.VarChar(256)
  reference    String? @db.VarChar(256)
  neighborhood String  @db.VarChar(256)
  city         String  @db.VarChar(256)
  state        String  @db.VarChar(256)

  phone01   String  @db.VarChar(256)
  phone02   String? @db.VarChar(256)
  cellphone String? @db.VarChar(256)
  email01   String  @db.VarChar(256)
  email02   String? @db.VarChar(256)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients   Client[]
  suppliers Supplier[]
  shippers  Shipper[]
  providers Provider[]
  sellers   Seller[]
  products  Product[]

  @@map("companies")
}

model Client {
  id              String    @id
  kind            String    @db.VarChar(256)
  cnpj            String    @unique @db.VarChar(256)
  ie              String    @db.VarChar(256)
  group           String    @db.VarChar(256)
  type            String    @db.VarChar(256)
  companyName     String    @db.VarChar(256)
  fantasyName     String    @db.VarChar(256)
  owner           String    @db.VarChar(256)
  headquarters    String    @db.VarChar(256)
  generateInvoice Boolean
  active          Boolean
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  resource        Owner? // resource no sentido de proprietário
  companies       Company[]

  @@map("clients")
}

model Supplier {
  id             String    @id
  cnpj           String    @unique @db.VarChar(256)
  ie             String    @db.VarChar(256)
  group          String    @db.VarChar(256)
  type           String    @db.VarChar(256)
  companyName    String    @db.VarChar(256)
  fantasyName    String    @db.VarChar(256)
  representative String    @db.VarChar(256)
  active         Boolean
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resource       Owner? // resource no sentido de proprietário
  companies      Company[]
  products       Product[]

  @@map("suppliers")
}

model Owner {
  id          String       @id
  addresses   Address[]
  contacts    Contact[]
  licenses    License[]
  attachments Attachment[]
  items       Item[]

  clientId   String?   @unique
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  supplierId String?   @unique
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("owners")
}

model Address {
  id           String   @id @default(uuid())
  isMain       Boolean
  nickname     String?  @db.VarChar(256)
  zipCode      String   @db.VarChar(256)
  street       String   @db.VarChar(512)
  number       String   @db.VarChar(256)
  complement   String?  @db.VarChar(256)
  reference    String?  @db.VarChar(256)
  neighborhood String   @db.VarChar(256)
  city         String   @db.VarChar(256)
  state        String   @db.VarChar(256)
  ownerId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  owner        Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Contact {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(256)
  department String   @db.VarChar(256)
  email      String   @db.VarChar(256)
  phone      String   @db.VarChar(256)
  whatsapp   String   @db.VarChar(256)
  info       String?  @db.Text
  ownerId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  owner      Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

model License {
  id               String   @id @default(uuid())
  paymentDay       Int
  bonusInCents     Int
  billingStartDate DateTime @db.Date
  license          String   @db.Text
  ownerId          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  owner            Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("licenses")
}

model Attachment {
  id        String   @id @default(uuid())
  name      String?  @db.VarChar(256)
  link      String   @db.Text
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Item {
  id               String   @id
  description      String   @db.Text
  serviceCode      String   @db.VarChar(256)
  quantity         Int
  unitPriceInCents Int
  ownerId          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  owner            Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("items")
}

model Shipper {
  id             String    @id @default(uuid())
  companyName    String    @db.VarChar(256)
  fantasyName    String    @db.VarChar(256)
  cnpj           String    @unique @db.VarChar(256)
  contact        String    @db.VarChar(256)
  representative String    @db.VarChar(256)
  zipCode        String    @db.VarChar(256)
  street         String    @db.VarChar(256)
  number         String    @db.VarChar(256)
  complement     String?   @db.VarChar(256)
  reference      String?   @db.VarChar(256)
  neighborhood   String    @db.VarChar(256)
  city           String    @db.VarChar(256)
  state          String    @db.VarChar(256)
  active         Boolean
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  companies      Company[]

  @@map("shippers")
}

model Provider {
  id                    String    @id @default(uuid())
  name                  String    @db.VarChar(256)
  type                  String    @db.VarChar(256)
  valueInCents          Int
  cnpj                  String    @unique @db.VarChar(256)
  ie                    String    @db.VarChar(256)
  paymentDay            Int?
  paymentExpirationDate DateTime? @db.Date
  companyName           String    @db.VarChar(256)
  zipCode               String    @db.VarChar(256)
  street                String    @db.VarChar(256)
  number                String    @db.VarChar(256)
  complement            String?   @db.VarChar(256)
  reference             String?   @db.VarChar(256)
  neighborhood          String    @db.VarChar(256)
  city                  String    @db.VarChar(256)
  state                 String    @db.VarChar(256)
  email                 String    @db.VarChar(256)
  website               String?   @db.VarChar(256)
  active                Boolean
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  companies             Company[]

  @@map("providers")
}

model Seller {
  id           String    @id @default(uuid())
  name         String    @db.VarChar(256)
  nickname     String?   @db.VarChar(256)
  phone        String    @db.VarChar(256)
  cellphone    String    @db.VarChar(256)
  commission   Float
  zipCode      String    @db.VarChar(256)
  street       String    @db.VarChar(256)
  number       String    @db.VarChar(256)
  complement   String?   @db.VarChar(256)
  reference    String?   @db.VarChar(256)
  neighborhood String    @db.VarChar(256)
  city         String    @db.VarChar(256)
  state        String    @db.VarChar(256)
  observation  String?   @db.Text
  avatarUrl    String?   @db.Text
  active       Boolean
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String    @unique
  companies    Company[]

  @@map("sellers")
}

model Product {
  id               String                 @id @default(uuid())
  type             String                 @db.VarChar(256)
  group01          String                 @db.VarChar(256)
  group02          String                 @db.VarChar(256)
  description      String                 @db.Text
  complement       String?                @db.Text
  manufacturerCode String                 @db.VarChar(256)
  brand            String                 @db.VarChar(256)
  measureUnit      String                 @db.VarChar(256)
  ncm              String                 @db.VarChar(256)
  economicBatch    String                 @db.VarChar(256)
  minimumStock     Int
  maximumStock     Int
  warrantyDays     Int
  weightInKg       Float
  heightInCm       Float
  lengthInCm       Float
  widthInCm        Float
  markup           Float
  marginB          Float
  currency         String                 @db.VarChar(10)
  exchangeRate     Float
  unitCostInCents  Int
  unitPriceInCents Int
  ean              String                 @db.VarChar(256)
  additionalInfo   String?                @db.Text
  images           String[]
  currentStock     Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  companyId        String
  company          Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  movements        ProductStockMovement[]
  suppliers        Supplier[]

  @@unique([ean, companyId])
  @@map("products")
}

model ProductStockMovement {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type             String
  quantity         Int
  unitPriceInCents Int
  createdAt        DateTime @default(now())

  @@map("stock_movements")
}

model ServiceCategory {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(256)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_categories")
}
