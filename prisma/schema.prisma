generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(uuid())
  email              String  @unique
  password           String  @db.Text
  passwordResetToken String? @db.VarChar(64)
  status             String
  roles              Role[]
}

model Role {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      String

  admin Admin?

  @@unique([accountId, role])
}

model Admin {
  accountId String   @unique
  name      String
  document  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId    String   @unique

  @@id([accountId])
}

model Client {
  id              String   @unique @default(uuid())
  kind            String
  cnpj            String   @unique
  ie              String   @unique
  group           String
  type            String
  generateInvoice Boolean
  companyName     String
  fantasyName     String
  owner           String
  headquarters    String
  active          Boolean
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Address {
  id           String   @id @default(uuid())
  isMain       Boolean
  nickname     String?
  zipCode      String
  street       String
  number       String
  complement   String?
  reference    String?
  neighborhood String
  city         String
  state        String
  ownerId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Faq {
  id        String   @id @default(uuid())
  question  String   @db.Text
  answer    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Text {
  id        String   @id @default(uuid())
  type      String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
