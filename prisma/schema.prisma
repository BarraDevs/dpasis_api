generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(uuid())
  email              String  @unique
  password           String  @db.Text
  passwordResetToken String? @db.VarChar(64)
  status             String
  roles              Role[]

  @@map("accounts")
}

model Role {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      String

  admin Admin?

  @@unique([accountId, role])
  @@map("roles")
}

model Admin {
  accountId String   @unique
  name      String   @db.VarChar(256)
  document  String   @unique @db.VarChar(256)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId    String   @unique

  @@id([accountId])
  @@map("admins")
}

model Company {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(256)
  fantasyName String  @db.VarChar(256)
  document    String  @unique @db.VarChar(256)
  ie          String  @db.VarChar(256)
  active      Boolean

  zipCode      String  @db.VarChar(256)
  street       String  @db.VarChar(512)
  number       String  @db.VarChar(256)
  complement   String? @db.VarChar(256)
  reference    String? @db.VarChar(256)
  neighborhood String  @db.VarChar(256)
  city         String  @db.VarChar(256)
  state        String  @db.VarChar(256)

  phone01   String  @db.VarChar(256)
  phone02   String? @db.VarChar(256)
  cellphone String? @db.VarChar(256)
  email01   String  @db.VarChar(256)
  email02   String? @db.VarChar(256)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  clients   Client[]
  suppliers Supplier[]

  @@map("companies")
}

model Client {
  id              String    @id
  kind            String    @db.VarChar(256)
  cnpj            String    @unique @db.VarChar(256)
  ie              String    @db.VarChar(256)
  group           String    @db.VarChar(256)
  type            String    @db.VarChar(256)
  companyName     String    @db.VarChar(256)
  fantasyName     String    @db.VarChar(256)
  owner           String    @db.VarChar(256)
  headquarters    String    @db.VarChar(256)
  generateInvoice Boolean
  active          Boolean
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  resource        Owner? // resource no sentido de proprietário
  companies       Company[]

  @@map("clients")
}

model Supplier {
  id             String    @id
  cnpj           String    @unique @db.VarChar(256)
  ie             String    @db.VarChar(256)
  group          String    @db.VarChar(256)
  type           String    @db.VarChar(256)
  companyName    String    @db.VarChar(256)
  fantasyName    String    @db.VarChar(256)
  representative String    @db.VarChar(256)
  active         Boolean
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resource       Owner? // resource no sentido de proprietário
  companies      Company[]

  @@map("suppliers")
}

model Owner {
  id          String       @id
  addresses   Address[]
  contacts    Contact[]
  licenses    License[]
  attachments Attachment[]
  items       Item[]

  clientId String? @unique
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  supplierId String?   @unique
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("owners")
}

model Address {
  id           String   @id @default(uuid())
  isMain       Boolean
  nickname     String?  @db.VarChar(256)
  zipCode      String   @db.VarChar(256)
  street       String   @db.VarChar(512)
  number       String   @db.VarChar(256)
  complement   String?  @db.VarChar(256)
  reference    String?  @db.VarChar(256)
  neighborhood String   @db.VarChar(256)
  city         String   @db.VarChar(256)
  state        String   @db.VarChar(256)
  ownerId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  owner        Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Contact {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(256)
  department String   @db.VarChar(256)
  email      String   @db.VarChar(256)
  phone      String   @db.VarChar(256)
  whatsapp   String   @db.VarChar(256)
  info       String?  @db.Text
  ownerId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  owner      Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

model License {
  id               String   @id @default(uuid())
  paymentDay       Int
  bonusInCents     Int
  billingStartDate DateTime @db.Date
  license          String   @db.Text
  ownerId          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  owner            Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("licenses")
}

model Attachment {
  id        String   @id @default(uuid())
  name      String?  @db.VarChar(256)
  link      String   @db.Text
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Item {
  id               String   @id
  description      String   @db.Text
  serviceCode      String   @db.VarChar(256)
  quantity         Int
  unitPriceInCents Int
  ownerId          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  owner            Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("items")
}

model Shipper {
  id             String   @id @default(uuid())
  companyName    String   @db.VarChar(256)
  fantasyName    String   @db.VarChar(256)
  cnpj           String   @unique @db.VarChar(256)
  contact        String   @db.VarChar(256)
  representative String   @db.VarChar(256)
  zipCode        String   @db.VarChar(256)
  street         String   @db.VarChar(256)
  number         String   @db.VarChar(256)
  complement     String?  @db.VarChar(256)
  reference      String?  @db.VarChar(256)
  neighborhood   String   @db.VarChar(256)
  city           String   @db.VarChar(256)
  state          String   @db.VarChar(256)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("shippers")
}

model Faq {
  id        String   @id @default(uuid())
  question  String   @db.Text
  answer    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model Text {
  id        String   @id @default(uuid())
  type      String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("texts")
}
