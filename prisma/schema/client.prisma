model Client {
  id                  Int      @id
  type                String
  parentClientId      Int?
  isSubClient         Boolean  @default(false)
  document            String
  ie                  String?
  groupId             Int
  resaleId            Int
  companyId           Int
  attendanceId        Int?
  maintenanceTicketId Int?
  honorificId         Int?
  companyName         String
  fantasyName         String?
  socialName          String?
  domain              String?
  headquarters        String
  invoiceType         String
  generateInvoice     Boolean
  active              Boolean
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  parent   Client?  @relation("ClientSubClients", fields: [parentClientId], references: [id])
  children Client[] @relation("ClientSubClients")

  group             ClientGroup              @relation(fields: [groupId], references: [id])
  resale            Resale                   @relation(fields: [resaleId], references: [id])
  company           Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  attendance        ClientAttendance?        @relation(fields: [attendanceId], references: [id])
  maintenanceTicket ClientMaintenanceTicket? @relation(fields: [maintenanceTicketId], references: [id])
  honorific         Honorific?               @relation(fields: [honorificId], references: [id], onDelete: Restrict)

  addresses     ClientAddress[]
  attachments   ClientAttachment[]
  contacts      ClientContact[]
  items         ClientItem[]
  invoiceConfig ClientInvoiceConfig?
  discounts     ClientDiscount[]
  types         ClientType[]

  @@map("clients")
}

model ClientAttendance {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]

  @@map("client_attendances")
}

model ClientMaintenanceTicket {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]

  @@map("client_maintenance_tickets")
}

model ClientAttachment {
  id          Int      @id @default(autoincrement())
  clientId    Int
  description String   @db.Text
  link        String   @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([link])
  @@map("client_attachments")
}

model ClientGroup {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]

  @@map("client_groups")
}

model ClientOwner {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_owners")
}

model ClientContact {
  id           Int      @id @default(autoincrement())
  clientId     Int
  departmentId Int
  name         String
  email        String
  phone        String?
  whatsapp     String?
  observations String?  @db.Text
  receiveNF    Boolean
  active       Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client     Client     @relation(fields: [clientId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([clientId, email])
  @@map("client_contacts")
}

model ClientAddress {
  id           Int      @id @default(autoincrement())
  clientId     Int
  type         String
  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  cityCodeIbge String?  @db.VarChar(7)
  state        String
  active       Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client                  Client                @relation(fields: [clientId], references: [id])
  invoiceConfigsAsBilling ClientInvoiceConfig[]
  clientTypes             ClientType[]

  @@unique([clientId, type])
  @@map("client_addresses")
}

model ClientItem {
  id               Int      @id @default(autoincrement())
  clientId         Int
  description      String
  quantity         Int
  unitValueInCents Int
  cnaeNbsIndopId   Int
  active           Boolean
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client       Client       @relation(fields: [clientId], references: [id])
  cnaeNbsIndop CnaeNbsIndop @relation(fields: [cnaeNbsIndopId], references: [id])

  @@map("client_items")
}

model ClientInvoiceConfig {
  id                Int      @id @default(autoincrement())
  clientId          Int      @unique
  generateNf        Boolean
  type              String
  emissionDay       Int
  dueDateType       String
  dueDateDay        Int?
  dueMonth          Int?
  deadlineDays      Int?
  months            Int[]    @default([])
  billingAddressId  Int
  bankId            Int
  autoProtestBoleto Boolean
  message           String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  billingAddress ClientAddress @relation(fields: [billingAddressId], references: [id])
  bank           Bank          @relation(fields: [bankId], references: [id])

  @@map("client_invoice_configs")
}

model ClientDiscount {
  id                  Int      @id @default(autoincrement())
  clientId            Int
  description         String   @db.Text
  type                String
  discountValue       Int
  month               Int
  year                Int
  doNotGenerateCharge Boolean
  terminateContract   Boolean
  active              Boolean
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@map("client_discounts")
}
