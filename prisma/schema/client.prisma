model Client {
  id              Int      @id @default(autoincrement())
  type            String
  document        String   @unique
  ie              String?
  groupId         Int
  ownerId         Int
  companyName     String
  fantasyName     String?
  headquarters    String
  invoiceType     String
  generateInvoice Boolean
  active          Boolean
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group         ClientGroup          @relation(fields: [groupId], references: [id])
  owner         ClientOwner          @relation(fields: [ownerId], references: [id])
  companies     Company[]
  addresses     ClientAddress[]
  contacts      ClientContact[]
  items         ClientItem[]
  invoiceConfig ClientInvoiceConfig?
  discounts     ClientDiscount[]
  attachments   ClientAttachment[]

  @@map("clients")
}

model ClientGroup {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]

  @@map("client_groups")
}

model ClientOwner {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]

  @@map("client_owners")
}

model ClientDepartment {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts ClientContact[]

  @@map("client_departments")
}

model ClientAttendanceType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_attendance_types")
}

model ClientMaintenanceTicketType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_maintenance_ticket_types")
}

model ClientContact {
  id           Int      @id @default(autoincrement())
  clientId     Int
  departmentId Int
  name         String
  email        String
  phone        String?
  whatsapp     String?
  observations String?  @db.Text
  receiveNF    Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client     Client           @relation(fields: [clientId], references: [id])
  department ClientDepartment @relation(fields: [departmentId], references: [id])

  @@unique([clientId, email])
  @@map("client_contacts")
}

model ClientAddress {
  id           Int      @id @default(autoincrement())
  clientId     Int
  type         String
  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client                  Client                @relation(fields: [clientId], references: [id])
  invoiceConfigsAsBilling ClientInvoiceConfig[]

  @@unique([clientId, type])
  @@map("client_addresses")
}

model ClientAttachment {
  id          Int      @id @default(autoincrement())
  clientId    Int
  description String   @db.Text
  link        String   @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_attachments")
}

model ClientItem {
  id               Int      @id @default(autoincrement())
  clientId         Int
  description      String
  quantity         Int
  unitValueInCents Int
  cnaeNbsIndopId   Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client       Client       @relation(fields: [clientId], references: [id])
  cnaeNbsIndop CnaeNbsIndop @relation(fields: [cnaeNbsIndopId], references: [id])

  @@map("client_items")
}

model ClientInvoiceConfig {
  id                Int      @id @default(autoincrement())
  clientId          Int      @unique
  generateNf        Boolean
  type              String
  emissionDay       Int
  dueDateType       String
  dueDateDay        Int?
  deadlineDays      Int?
  months            Int[]    @default([])
  billingAddressId  Int
  bankId            Int
  autoProtestBoleto Boolean
  message           String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  billingAddress ClientAddress @relation(fields: [billingAddressId], references: [id])
  bank           Bank          @relation(fields: [bankId], references: [id])

  @@map("client_invoice_configs")
}

model ClientDiscount {
  id                  Int      @id @default(autoincrement())
  clientId            Int
  description         String   @db.Text
  type                String
  discountValue       Int
  month               Int
  year                Int
  doNotGenerateCharge Boolean
  terminateContract   Boolean
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@map("client_discounts")
}
