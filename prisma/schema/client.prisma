model Client {
  id              Int      @id @default(autoincrement())
  type            String
  document        String   @unique
  ie              String?
  groupId         Int
  ownerId         Int
  companyName     String
  fantasyName     String?
  headquarters    String
  invoiceType     String
  generateInvoice Boolean
  active          Boolean
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group     ClientGroup     @relation(fields: [groupId], references: [id])
  owner     ClientOwner     @relation(fields: [ownerId], references: [id])
  addresses ClientAddress[]

  @@map("clients")
}

model ClientGroup {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]

  @@map("client_groups")
}

model ClientOwner {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]

  @@map("client_owners")
}

model ClientAddress {
  id           Int      @id @default(autoincrement())
  clientId     Int
  type         String
  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, type])
  @@map("client_addresses")
}
