model Resale {
  id                   Int      @id
  name                 String
  identifier           String?
  zipCode              String
  street               String
  neighborhood         String
  city                 String
  state                String
  licenseType          String
  document             String   @unique
  ie                   String?
  phone01              String
  phone02              String?
  voucher              String?
  email                String?
  website              String?
  receivesSupportEmail Boolean  @default(false)
  servedByDpa          Boolean  @default(false)
  manufacturerReseller Boolean  @default(false)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  clients Client[]

  @@map("resales")
}
