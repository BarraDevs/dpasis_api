model Resale {
  id                   Int      @id
  name                 String
  identifier           String?
  zipCode              String
  street               String
  neighborhood         String
  city                 String
  state                String
  licenseType          String
  document             String   @unique
  ie                   String?
  phone01              String
  phone02              String?
  voucher              String?
  email                String?
  website              String?
  receivesSupportEmail Boolean  @default(false)
  servedByDpa          Boolean  @default(false)
  manufacturerReseller Boolean  @default(false)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  clients  Client[]
  contacts ResaleContact[]

  @@map("resales")
}

model ResaleDepartment {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts ResaleContact[]

  @@map("resale_departments")
}

model ResaleContact {
  id           Int      @id @default(autoincrement())
  resaleId     Int
  departmentId Int
  name         String
  email        String
  phone        String?
  whatsapp     String?
  observations String? @db.Text
  receiveNF    Boolean
  active       Boolean
  createdAt    DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resale     Resale           @relation(fields: [resaleId], references: [id])
  department ResaleDepartment @relation(fields: [departmentId], references: [id])

  @@unique([resaleId, email])
  @@map("resale_contacts")
}
