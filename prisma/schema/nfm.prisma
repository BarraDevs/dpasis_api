model Nfm {
  id                Int      @id @default(autoincrement())
  clientId          Int
  clientDocument    String
  companyName       String
  status            String
  referenceMonth    Int
  referenceYear     Int
  totalValueInCents Int
  cnaeNbsIndopId    Int
  nfseId            Int?     @unique
  data              Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cnaeNbsIndop CnaeNbsIndop @relation(fields: [cnaeNbsIndopId], references: [id], onDelete: Restrict)
  nfse         Nfse?        @relation(fields: [nfseId], references: [id], onDelete: Restrict)

  @@unique([clientId, referenceMonth, referenceYear, cnaeNbsIndopId])
  @@map("nfms")
}
