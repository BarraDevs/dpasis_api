model Nfm {
  id                Int      @id @default(autoincrement())
  clientId          Int
  clientDocument    String
  companyName       String
  referenceMonth    Int
  referenceYear     Int
  totalValueInCents Int
  cnaeNbsIndopId    Int
  nfseId            Int?     @unique
  data              Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cnaeNbsIndop CnaeNbsIndop @relation(fields: [cnaeNbsIndopId], references: [id], onDelete: Restrict)
  nfse         Nfse?        @relation(fields: [nfseId], references: [id], onDelete: Restrict)

  @@unique([clientId, referenceMonth, referenceYear, cnaeNbsIndopId])
  @@map("nfms")
}

model NfmCronRun {
  id           Int      @id @default(autoincrement())
  createdCount Int
  skippedCount Int
  failedCount  Int
  errors       Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("nfm_cron_runs")
}
