model Service {
  id                 Int      @id @default(autoincrement())
  cnaeNbsIndopId     Int
  billedId           Int
  categoryId         Int
  deliveryTermId     Int
  freightId          Int
  proposalValidityId Int
  warrantyId         Int
  name               String
  unitPriceInCents   Int
  description        String   @db.Text
  isCommercial       Boolean
  active             Boolean
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cnaeNbsIndop            CnaeNbsIndop             @relation(fields: [cnaeNbsIndopId], references: [id])
  billed                  Billed                   @relation(fields: [billedId], references: [id])
  category                Category                 @relation(fields: [categoryId], references: [id])
  deliveryTerm            DeliveryTerm             @relation(fields: [deliveryTermId], references: [id])
  freight                 Freight                  @relation(fields: [freightId], references: [id])
  proposalValidity        ProposalValidity         @relation(fields: [proposalValidityId], references: [id])
  warranty                Warranty                 @relation(fields: [warrantyId], references: [id])
  serviceAttendanceValues ServiceAttendanceValue[]
  companies               Company[]

  @@map("services")
}

model ServiceAttendanceValue {
  id                Int      @id @default(autoincrement())
  serviceId         Int
  values            Json
  totalValueInCents Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_attendance_values")
}
