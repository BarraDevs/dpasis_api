model Account {
  id                 Int     @id @default(autoincrement())
  role               String
  name               String
  email              String  @unique
  password           String  @db.Text
  passwordResetToken String? @db.VarChar(64)
  status             String

  admin  Admin?
  claims AccountClaim[]

  @@unique([id, role])
  @@map("accounts")
}

model AccountClaim {
  id        Int     @id @default(autoincrement())
  accountId Int
  subject   String
  action    String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, subject, action])
  @@map("account_claims")
}
