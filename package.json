{
  "name": "dpasis_api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "NODE_ENV=development nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_ENV=test jest --runInBand",
    "test:watch": "NODE_ENV=test jest --watch --runInBand",
    "test:cov": "NODE_ENV=test jest --coverage --runInBand",
    "test:e2e": "NODE_ENV=test QUEUE_E2E=true jest --runInBand nfse-flow",
    "test:debug": "NODE_ENV=test node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "db:migration": "dotenv -e .env.development -- prisma migrate dev",
    "db:migration:create": "dotenv -e .env.development -- prisma migrate dev --create-only",
    "db:deploy": "dotenv -e .env.production -- prisma migrate deploy",
    "db:status": "dotenv -e .env.development -- prisma migrate status",
    "db:seed": "dotenv -e .env.development -- prisma db seed",
    "db:reset": "dotenv -e .env.development -- prisma migrate reset --force",
    "db:studio": "dotenv -e .env.development -- prisma studio",
    "generate:module": "ts-node -r tsconfig-paths/register scripts/cli.ts",
    "generate:postman": "ts-node -r tsconfig-paths/register postman/swagger-to-postman.ts",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:dev:detach": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml up -d --build",
    "docker:dev:deps": "docker compose -f docker-compose.dev.yml up postgres redis -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod": "docker compose up -d --build",
    "docker:prod:down": "docker compose down"
  },
  "prisma": {
    "schema": "./prisma/schema",
    "seed": "dotenv -e .env.development -- ts-node prisma/seeds/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@bull-board/api": "^8.4.0",
    "@bull-board/express": "^8.4.0",
    "@bull-board/nestjs": "^8.4.0",
    "@casl/ability": "^6.8.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^8.0.7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "axios": "^1.12.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.81.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.0",
    "dotenv-cli": "^10.0.0",
    "express-basic-auth": "^1.2.1",
    "fast-xml-parser": "^5.10.1",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "luxon": "^3.6.1",
    "node-forge": "^1.4.0",
    "nodemailer": "^6.10.0",
    "nodemailer-express-handlebars": "^6.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "winston": "^3.17.0",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@golevelup/ts-jest": "^0.6.1",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/luxon": "^3.6.2",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.3.1",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^6.4.17",
    "@types/nodemailer-express-handlebars": "^4.0.5",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "jest": "^29.5.0",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "modulePaths": [
      "<rootDir>"
    ]
  }
}
