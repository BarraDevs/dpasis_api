# Server
PORT=
SSL_KEY=/etc/letsencrypt/live/domain.com/privkey.pem
SSL_CERT=/etc/letsencrypt/live/domain.com/fullchain.pem
SSL_CA=/etc/letsencrypt/live/domain.com/chain.pem

# CORS
CORS_ORIGIN=

# Jwt
JWT_SECRET=

# Database (PostgreSQL)
#
# O banco de teste é OUTRO banco, e o nome tem de terminar em `_test`: a suíte de integração trunca
# todas as tabelas antes de cada spec, e `PrismaService.truncate()` se recusa a rodar fora dessa
# convenção. Sem a separação, um `npm test` na máquina errada apaga o banco de trabalho.
#   .env.development → .../dpasis
#   .env.test        → .../dpasis_test   (criar uma vez: createdb dpasis_test)
DATABASE_URL=postgresql://postgres:password@localhost:5432/dpasis?schema=public

# Upload file
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# SMTP — canal único de alerta do fluxo de NFS-e.
# Sem servidor real aqui a operação fica cega: os alertas de nota presa, nota emitida sem cobrança,
# cobrança com falha, ressalva do fisco, certificado a vencer e backlog de fila são todos e-mail.
# `SMTP_PORT` precisa ser numérica — um valor de fachada passava na validação e só falhava dentro do
# nodemailer, em silêncio. Confira a entrega em GET /admin/health/smtp antes de contar com o canal.
SMTP_HOST=
SMTP_PORT=587
SMTP_TO=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Redis
REDIS_URL=

# Queue dashboard (Bull Board)
QUEUE_DASHBOARD_USERNAME=
QUEUE_DASHBOARD_PASSWORD=

# CNPJA
CNPJA_API_URL=https://open.cnpja.com/office

# ViaCEP
VIACEP_API_URL=https://viacep.com.br/ws

# NFeMail
NFEMAIL_API_URL=https://api.nfemail.com.br
NFEMAIL_CNPJ=
NFEMAIL_API_KEY=

# GissOnline
#
# Os certificados NÃO são versionados: os arquivos ficam em `resources/files/`, fora do git
# (.gitignore) e fora da imagem Docker (.dockerignore), e chegam em cada ambiente por cópia manual —
# o docker-compose os monta somente leitura. Ver docs/runbook-certificados.md.
# Numa VPS compartilhada a proteção passa a ser permissão de arquivo: `chmod 600`, dono exclusivo do
# usuário que roda a aplicação.
GISS_PROVIDER_ENABLED=true
GISS_CERT_PATH=resources/files/nfs-generation/giss/name-of-the-certificate.pfx
GISS_CERT_PASSWORD=

# Banco Inter (OAuth + mTLS) — só obrigatório se INTER_PROVIDER_ENABLED=true
#
# Em homologação o boleto só existe com INTER_PROVIDER_ENABLED=true: com `false` a estratégia do
# Inter nem é registrada e toda emissão de cobrança falha de forma permanente, deixando a NFS-e
# emitida sem cobrança. A URL abaixo é a de sandbox — o certificado mTLS de produção ainda não foi
# emitido, então nenhum boleto desta rodada é cobrável de verdade.
INTER_PROVIDER_ENABLED=false
INTER_API_URL=https://cdpj-sandbox.partners.uatinter.co
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=resources/files/bank-payment/inter/name-of-the-certificate.crt
INTER_KEY_PATH=resources/files/bank-payment/inter/name-of-the-key.key

# Rate limiting (opcional; defaults: limite 100 / janela 60s)
# THROTTLE_LIMIT=100
# THROTTLE_TTL_MS=60000